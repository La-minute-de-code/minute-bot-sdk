{
  "name": "@la_minute_code/sdk",
  "version": "0.2.0",
  "description": "SDK public pour écrire des plugins Minute Bot.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/La-minute-de-code/minute-bot-sdk.git"
  },
  "homepage": "https://github.com/La-minute-de-code/minute-bot-sdk#readme",
  "bugs": {
    "url": "https://github.com/La-minute-de-code/minute-bot-sdk/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "discord.js": "^14.27.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
